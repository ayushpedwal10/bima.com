{
  "buildCommand": "cd health-advisor && npm run build",
  "outputDirectory": "health-advisor/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api.py": {
      "includeFiles": "data/policies.json",
      "excludeFiles": "{app.py,health-advisor/**,data/customers.json,data/customers.csv,data/insurers.json,data/generate_*.py}"
    }
  }
}
